# Gradle and Kotlin build caches
/.gradle/
/.kotlin/
**/build/

# Android SDK path, set locally by Android Studio
/local.properties

# Android Studio / IntelliJ local project files
/.idea/
*.iml

# Android build outputs
*.apk
*.aab
*.ap_
*.dex
captures/

# Native build outputs, if added later
.externalNativeBuild/
.cxx/

# Temporary handoff and scratch material
/handoff/
/scratch
/scr
/scr-*

# User data
/key.txt

# OS and editor temporary files
.DS_Store
Thumbs.db
*.swp
*.swo
*.tmp