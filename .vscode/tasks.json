{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Install APK on emulator",
      "type": "process",
      "command": "powershell.exe",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy", "Bypass",
        "-File", "${workspaceFolder}\\scripts\\install-apk.ps1",
        "-ApkPath", "${input:apkPath}"
      ],
      "presentation": {
        "reveal": "always",
        "focus": true,
        "panel": "shared",
        "clear": true
      },
      "problemMatcher": []
    },
    {
      "label": "push",
      "type": "process",
      "command": "git",
      "args": [
        "push2"      
      ],
      "presentation": {
        "reveal": "always",
        "focus": true,
        "panel": "shared",
        "clear": true
      },
      "problemMatcher": []
    }
  ],
  "inputs": [
    {
      "id": "apkPath",
      "type": "promptString",
      "description": "APK path (absolute, or relative to the project folder)",
      "default": "app\\build\\outputs\\apk\\debug\\app-debug.apk"
    }
  ]
}
